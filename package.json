{
  "name": "portfolio-v3",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "prepare": "husky && panda codegen",
    "dev": "rm -rf .next && next dev --webpack",
    "build": "panda codegen && next build --webpack && next-sitemap",
    "analyze": "cross-env ANALYZE=true next build --webpack",
    "typecheck": "tsc --noEmit",
    "start": "next start",
    "lint": "oxlint",
    "lint:staged": "lint-staged"
  },
  "lint-staged": {
    "./src/**/*.{js,jsx,ts,tsx}": [
      "oxlint --fix",
      "oxfmt"
    ]
  },
  "dependencies": {
    "@giscus/react": "^3.1.0",
    "@mdx-js/loader": "^3.1.1",
    "@mdx-js/react": "^3.1.1",
    "@next/mdx": "16.4.6",
    "@radix-ui/colors": "^3.0.0",
    "@radix-ui/react-aspect-ratio": "^1.2.0",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-visually-hidden": "^1.2.13",
    "@types/mdx": "^2.0.14",
    "@ui-sdk/core": "0.1.0-beta.1",
    "@ui-sdk/react": "0.1.0-beta.1",
    "@vercel/analytics": "^2.0.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "embla-carousel-react": "^8.6.0",
    "gray-matter": "^4.0.3",
    "motion": "^14.14.0",
    "next": "16.4.6",
    "next-sitemap": "^4.2.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-error-boundary": "^6.1.6",
    "reading-time": "^1.5.0",
    "rehype-pretty-code": "^0.14.6",
    "remark-frontmatter": "^5.0.0",
    "sharp": "^0.35.5",
    "shiki": "^4.6.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@next/bundle-analyzer": "16.4.6",
    "@pandacss/dev": "^2.5.0",
    "@pandacss/preset-base": "2.5.0",
    "@types/node": "^25.9.9",
    "@types/react": "19.3.0",
    "cross-env": "^10.1.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "oxfmt": "^0.78.0",
    "oxlint": "^1.93.0",
    "oxlint-tsgolint": "^7.0.2007",
    "postcss": "^8.5.33",
    "postcss-flexbugs-fixes": "^5.0.2",
    "postcss-preset-env": "^11.6.2",
    "typescript": "^7.0.2"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "sharp",
      "unrs-resolver"
    ],
    "overrides": {
      "@types/react": "19.3.0"
    }
  }
}
